{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT r.id, r.source_id, s.owner, s.repo, s.branch, r.file_path, r.title, r.type, r.like_count\n            FROM resources r\n            JOIN sources s ON r.source_id = s.id\n            WHERE r.course_id IS NULL AND s.source_status NOT IN ('archived', 'error')\n            ",
