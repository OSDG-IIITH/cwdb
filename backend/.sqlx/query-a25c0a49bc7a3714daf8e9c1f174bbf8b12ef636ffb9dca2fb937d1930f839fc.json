{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT r.id, r.source_id, s.owner, s.repo, s.branch, r.file_path, r.title, r.type, r.like_count \n            FROM resources r \n            JOIN sources s ON r.source_id = s.id \n            WHERE s.source_status NOT IN ('archived', 'error') AND s.owner = $1 AND s.repo = $2\n            ",
